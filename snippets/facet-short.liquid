<label for="SortBy-{{ context }}" class="text-nowrap {{ label_class }}">
  {{- 'products.facets.sort_by_label' | t -}}
  :</label
>
<div class="select w-auto facet-short flex items-center gap-2 flex-grow">
  {%- assign sort_by = results.sort_by | default: results.default_sort_by -%}
  <select
    name="sort_by"
    class="form-control form-control--select"
    id="SortBy-{{ context }}"
    aria-describedby="a11y-refresh-page-message"
    is="facet-short"
  >
    {%- for option in results.sort_options -%}
      {%- case option.value -%}
        {%- when 'manual' -%}
          {%- assign sort_label = 'products.facets.sort_manual' | t -%}
        {%- when 'best-selling' -%}
          {%- assign sort_label = 'products.facets.sort_best_selling' | t -%}
        {%- when 'title-ascending' -%}
          {%- assign sort_label = 'products.facets.sort_title_ascending' | t -%}
        {%- when 'title-descending' -%}
          {%- assign sort_label = 'products.facets.sort_title_descending' | t -%}
        {%- when 'price-ascending' -%}
          {%- assign sort_label = 'products.facets.sort_price_ascending' | t -%}
        {%- when 'price-descending' -%}
          {%- assign sort_label = 'products.facets.sort_price_descending' | t -%}
        {%- when 'created-ascending' -%}
          {%- assign sort_label = 'products.facets.sort_created_ascending' | t -%}
        {%- when 'created-descending' -%}
          {%- assign sort_label = 'products.facets.sort_created_descending' | t -%}
        {%- when 'relevance', 'most-relevant' -%}
          {%- assign sort_label = 'products.facets.sort_relevance' | t -%}
        {%- else -%}
          {%- assign sort_label = option.name -%}
      {%- endcase -%}
      <option
        value="{{ option.value | escape }}"
        {% if option.value == sort_by %}
          selected="selected"
        {% endif %}
      >
        {{ sort_label | escape }}
      </option>
    {%- endfor -%}
  </select>
  {% render 'icon-caret-down', size: '2xs' %}
</div>
